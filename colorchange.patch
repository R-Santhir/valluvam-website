# Across all .css files — box-shadow tint update
# Run: find css/ -name "*.css" | xargs sed -i 's/rgba(46, 12, 16,/rgba(12, 2, 4,/g'

--- (all css files)
+++ (all css files)
-  box-shadow: ... rgba(46, 12, 16, 0.12);
+  box-shadow: ... rgba(12, 2, 4, 0.15);

