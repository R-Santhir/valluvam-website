-    radial-gradient(ellipse 60% 50% at 80% 50%, rgba(139, 32, 40, 0.4) 0%, transparent 70%),
-    radial-gradient(ellipse 40% 60% at 20% 80%, rgba(201, 154, 46, 0.08) 0%, transparent 60%);
